---
import { withBase } from '../lib/content';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-about">
      <p class="footer-brand"><span class="brand-mark">▲</span> team-continue</p>
      <p class="footer-desc">
        ロボコンに挑戦し続けるロボット開発チーム。メカ・回路・ソフトウェアの技術情報を発信しています。
      </p>
    </div>
    <nav class="footer-links" aria-label="フッターリンク">
      <a href="https://github.com/team-continue" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="https://x.com/team_continue" target="_blank" rel="noopener noreferrer">X (Twitter)</a>
      <a href={withBase('/links')}>SNS・LINK</a>
    </nav>
  </div>
  <div class="container footer-copy">
    <p>© {year} team-continue</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-bg-alt);
    padding: 2.5rem 0 1.5rem;
    margin-top: 3rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    justify-content: space-between;
    align-items: flex-start;
  }

  .footer-brand {
    font-weight: 700;
    font-size: 1.05rem;
    margin: 0 0 0.5rem;
    letter-spacing: 0.04em;
  }

  .brand-mark {
    color: var(--color-accent);
    font-size: 0.8rem;
  }

  .footer-desc {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.88rem;
    max-width: 420px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .footer-links a {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    padding: 0.3rem 0;
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  .footer-copy {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .footer-copy p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }
</style>
