---
import { SECTION_LABELS, withBase } from '../lib/content';

interface Props {
  projectSlug: string;
  /** 現在表示中のセクション ('overview' | 'mechanical' | 'electrical' | 'software') */
  current: string;
}

const { projectSlug, current } = Astro.props;

const items = [
  { key: 'overview', path: `/projects/${projectSlug}` },
  { key: 'mechanical', path: `/projects/${projectSlug}/mechanical` },
  { key: 'electrical', path: `/projects/${projectSlug}/electrical` },
  { key: 'software', path: `/projects/${projectSlug}/software` },
];
---

<nav class="local-nav" aria-label="プロジェクト内ナビゲーション">
  {items.map(({ key, path }) => (
    <a href={withBase(path)} aria-current={key === current ? 'page' : undefined}>
      {SECTION_LABELS[key]}
    </a>
  ))}
</nav>
