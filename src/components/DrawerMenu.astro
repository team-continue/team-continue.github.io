---
import { getProjects, SECTION_LABELS, withBase } from '../lib/content';

const projects = await getProjects();
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(path: string): boolean {
  const target = withBase(path).replace(/\/$/, '') || '/';
  return currentPath === target;
}

const sectionKeys = ['mechanical', 'electrical', 'software'] as const;
---

<div class="drawer-overlay" id="drawer-overlay" hidden></div>

<nav class="drawer" id="drawer" aria-label="サイトメニュー" aria-hidden="true">
  <div class="drawer-head">
    <span class="drawer-brand">team-continue</span>
    <button class="drawer-close" id="menu-close" type="button" aria-label="メニューを閉じる">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <line x1="5" y1="5" x2="19" y2="19"></line>
        <line x1="19" y1="5" x2="5" y2="19"></line>
      </svg>
    </button>
  </div>

  <ul class="drawer-list">
    <li>
      <a href={withBase('/')} aria-current={isActive('/') ? 'page' : undefined}>HOME</a>
    </li>
    <li>
      <a href={withBase('/projects')} aria-current={isActive('/projects') ? 'page' : undefined}>PROJECT</a>
      <ul class="drawer-sub">
        {projects.map((project) => (
          <li>
            <a
              href={withBase(`/projects/${project.data.slug}`)}
              aria-current={isActive(`/projects/${project.data.slug}`) ? 'page' : undefined}
            >
              {project.data.title}
            </a>
            <ul class="drawer-sub">
              <li>
                <a
                  href={withBase(`/projects/${project.data.slug}`)}
                  aria-current={isActive(`/projects/${project.data.slug}`) ? 'page' : undefined}
                >
                  {SECTION_LABELS.overview}
                </a>
              </li>
              {sectionKeys.map((section) => (
                <li>
                  <a
                    href={withBase(`/projects/${project.data.slug}/${section}`)}
                    aria-current={isActive(`/projects/${project.data.slug}/${section}`) ? 'page' : undefined}
                  >
                    {SECTION_LABELS[section]}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
        <li>
          <a href={withBase('/projects/others')} aria-current={isActive('/projects/others') ? 'page' : undefined}>
            その他プロジェクト
          </a>
        </li>
      </ul>
    </li>
    <li>
      <a href={withBase('/members')} aria-current={isActive('/members') ? 'page' : undefined}>MEMBERS</a>
    </li>
    <li>
      <a href={withBase('/links')} aria-current={isActive('/links') ? 'page' : undefined}>SNS・LINK</a>
    </li>
    <li>
      <a href={withBase('/blog')} aria-current={isActive('/blog') ? 'page' : undefined}>BLOG</a>
    </li>
  </ul>
</nav>

<style>
  .drawer-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(4, 7, 16, 0.6);
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .drawer-overlay.open {
    opacity: 1;
  }

  .drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    z-index: 201;
    width: min(320px, 86vw);
    background: var(--color-bg-alt);
    border-right: 1px solid var(--color-border);
    transform: translateX(-100%);
    transition: transform 0.28s ease;
    overflow-y: auto;
    padding-bottom: 2rem;
  }

  .drawer.open {
    transform: translateX(0);
    box-shadow: 12px 0 40px rgba(0, 0, 0, 0.5);
  }

  .drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 0.75rem 0.75rem 1.25rem;
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    background: var(--color-bg-alt);
  }

  .drawer-brand {
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    font-size: 0.95rem;
  }

  .drawer-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: none;
    border-radius: 10px;
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition: background var(--transition), color var(--transition);
  }

  .drawer-close:hover {
    background: var(--color-surface-hover);
    color: var(--color-accent);
  }

  .drawer-list,
  .drawer-sub {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .drawer-list {
    padding: 0.75rem 0;
  }

  .drawer-list a {
    display: block;
    padding: 0.7rem 1.25rem;
    color: var(--color-text);
    font-weight: 600;
    font-size: 0.95rem;
    border-left: 3px solid transparent;
    transition: background var(--transition), color var(--transition),
      border-color var(--transition);
  }

  .drawer-sub a {
    font-weight: 400;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .drawer-sub {
    padding-left: 0.9rem;
  }

  .drawer-sub .drawer-sub {
    padding-left: 0.9rem;
  }

  .drawer-list a:hover {
    background: var(--color-surface-hover);
    color: var(--color-accent);
    opacity: 1;
  }

  .drawer-list a[aria-current='page'] {
    color: var(--color-accent);
    border-left-color: var(--color-accent);
    background: rgba(56, 225, 255, 0.08);
  }

  @media (prefers-reduced-motion: reduce) {
    .drawer,
    .drawer-overlay {
      transition: none;
    }
  }
</style>

<script>
  const drawer = document.getElementById('drawer')!;
  const overlay = document.getElementById('drawer-overlay')!;
  const openBtn = document.getElementById('menu-open')!;
  const closeBtn = document.getElementById('menu-close')!;

  function openDrawer() {
    overlay.hidden = false;
    // hidden解除後にclassを付けてトランジションを発火させる
    requestAnimationFrame(() => {
      drawer.classList.add('open');
      overlay.classList.add('open');
    });
    drawer.setAttribute('aria-hidden', 'false');
    openBtn.setAttribute('aria-expanded', 'true');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer.classList.remove('open');
    overlay.classList.remove('open');
    drawer.setAttribute('aria-hidden', 'true');
    openBtn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
    overlay.addEventListener(
      'transitionend',
      () => {
        if (!overlay.classList.contains('open')) overlay.hidden = true;
      },
      { once: true }
    );
  }

  openBtn.addEventListener('click', openDrawer);
  closeBtn.addEventListener('click', closeDrawer);
  overlay.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer.classList.contains('open')) closeDrawer();
  });
</script>
