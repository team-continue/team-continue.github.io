---
import { withBase } from '../lib/content';
---

<div class="search-overlay" id="search-overlay" hidden>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="サイト内検索">
    <div class="search-input-row">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <line x1="21" y1="21" x2="16.5" y2="16.5"></line>
      </svg>
      <input
        type="search"
        id="search-input"
        placeholder="キーワードで検索…"
        autocomplete="off"
      />
      <button class="search-close" id="search-close" type="button" aria-label="検索を閉じる">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <line x1="5" y1="5" x2="19" y2="19"></line>
          <line x1="19" y1="5" x2="5" y2="19"></line>
        </svg>
      </button>
    </div>
    <p class="search-hint" id="search-hint">最新記事・主要プロジェクト</p>
    <ul class="search-results" id="search-results"></ul>
  </div>
</div>

<style>
  .search-overlay {
    position: fixed;
    inset: 0;
    z-index: 300;
    background: rgba(4, 7, 16, 0.7);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 10vh 1rem 2rem;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .search-overlay.open {
    opacity: 1;
  }

  .search-panel {
    width: 100%;
    max-width: 620px;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    max-height: 75vh;
  }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.5rem 0.6rem 0.5rem 1rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  #search-input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    color: var(--color-text);
    font-size: 1rem;
    padding: 0.6rem 0;
    font-family: inherit;
  }

  .search-close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 8px;
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition: background var(--transition), color var(--transition);
  }

  .search-close:hover {
    background: var(--color-surface-hover);
    color: var(--color-accent);
  }

  .search-hint {
    margin: 0;
    padding: 0.6rem 1rem 0.2rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    letter-spacing: 0.05em;
  }

  .search-results {
    list-style: none;
    margin: 0;
    padding: 0.4rem;
    overflow-y: auto;
  }

  .search-results :global(a) {
    display: block;
    padding: 0.65rem 0.75rem;
    border-radius: 8px;
    color: var(--color-text);
    transition: background var(--transition);
  }

  .search-results :global(a:hover) {
    background: var(--color-surface-hover);
    opacity: 1;
  }

  .search-results :global(.result-title) {
    font-weight: 600;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .search-results :global(.result-type) {
    font-size: 0.68rem;
    font-family: var(--font-mono);
    padding: 0.05rem 0.5rem;
    border-radius: 999px;
    background: rgba(124, 92, 255, 0.18);
    color: #b9a6ff;
    white-space: nowrap;
  }

  .search-results :global(.result-summary) {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin-top: 0.15rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .search-results :global(.no-results) {
    padding: 1.2rem 1rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
</style>

<script define:vars={{ searchJsonUrl: withBase('/search.json') }}>
  const overlay = document.getElementById('search-overlay');
  const input = document.getElementById('search-input');
  const results = document.getElementById('search-results');
  const hint = document.getElementById('search-hint');
  const openBtn = document.getElementById('search-open');
  const closeBtn = document.getElementById('search-close');

  let entries = null;

  async function loadEntries() {
    if (entries) return entries;
    const res = await fetch(searchJsonUrl);
    entries = await res.json();
    return entries;
  }

  function render(list, emptyMessage) {
    results.innerHTML = '';
    if (list.length === 0) {
      const li = document.createElement('li');
      li.className = 'no-results';
      li.textContent = emptyMessage;
      results.appendChild(li);
      return;
    }
    for (const item of list) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = item.url;

      const title = document.createElement('div');
      title.className = 'result-title';
      const type = document.createElement('span');
      type.className = 'result-type';
      type.textContent = item.type;
      const text = document.createElement('span');
      text.textContent = item.title;
      title.append(type, text);
      a.appendChild(title);

      if (item.summary) {
        const summary = document.createElement('div');
        summary.className = 'result-summary';
        summary.textContent = item.summary;
        a.appendChild(summary);
      }
      li.appendChild(a);
      results.appendChild(li);
    }
  }

  function search(query) {
    const q = query.trim().toLowerCase();
    if (q === '') {
      hint.textContent = '最新記事・主要プロジェクト';
      render(entries.filter((e) => e.featured), '候補がありません');
      return;
    }
    hint.textContent = '検索結果';
    const hits = entries.filter((e) =>
      e.keywords.some((k) => k.toLowerCase().includes(q))
    );
    render(hits.slice(0, 20), '該当する結果が見つかりませんでした');
  }

  async function openSearch() {
    overlay.hidden = false;
    requestAnimationFrame(() => overlay.classList.add('open'));
    document.body.style.overflow = 'hidden';
    await loadEntries();
    search(input.value);
    input.focus();
  }

  function closeSearch() {
    overlay.classList.remove('open');
    document.body.style.overflow = '';
    overlay.addEventListener(
      'transitionend',
      () => {
        if (!overlay.classList.contains('open')) overlay.hidden = true;
      },
      { once: true }
    );
  }

  openBtn.addEventListener('click', openSearch);
  closeBtn.addEventListener('click', closeSearch);
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeSearch();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !overlay.hidden) closeSearch();
  });
  input.addEventListener('input', () => search(input.value));
</script>
