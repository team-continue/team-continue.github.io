---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, withBase } from '../../lib/content';

const projects = await getProjects();
---

<BaseLayout
  title="PROJECT"
  description="team-continue のプロジェクト一覧。CoRE 2025 / CoRE 2026 への参戦記録と、その他の技術検証・試作活動を紹介します。"
>
  <div class="page-header">
    <h1>PROJECT</h1>
    <p class="lead">チームが取り組んでいるプロジェクトの一覧です。</p>
  </div>

  <div class="card-grid">
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
    <article class="card">
      <a href={withBase('/projects/others')} aria-label="その他プロジェクト">
        <div class="thumb-placeholder" aria-hidden="true">OTHERS</div>
      </a>
      <div class="card-body">
        <div class="card-meta">
          <span class="badge">通年</span>
          <span>試作・検証・勉強会</span>
        </div>
        <h3 class="card-title">
          <a href={withBase('/projects/others')}>その他プロジェクト</a>
        </h3>
        <p class="card-summary">
          大会参戦以外の小規模な試作、技術検証、勉強会などの活動をまとめています。
        </p>
      </div>
    </article>
  </div>
</BaseLayout>
