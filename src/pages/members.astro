---
import BaseLayout from '../layouts/BaseLayout.astro';
import MemberCard from '../components/MemberCard.astro';
import { getMembers, getProjects, getPublishedPosts } from '../lib/content';

const members = await getMembers();
const projects = await getProjects();
const posts = await getPublishedPosts();

const projectTitles = Object.fromEntries(
  projects.map((p) => [p.data.slug, p.data.title])
);
---

<BaseLayout
  title="MEMBERS"
  description="team-continue のメンバー紹介。メカ・回路・ソフトウェアそれぞれの担当メンバーと、その得意分野を紹介します。"
>
  <div class="page-header">
    <h1>MEMBERS</h1>
    <p class="lead">team-continue のメンバーを紹介します。</p>
  </div>

  <div class="card-grid cols-2">
    {members.map((member) => (
      <MemberCard
        member={member}
        projectTitles={projectTitles}
        posts={posts.filter((post) => post.data.authorSlug === member.data.slug)}
      />
    ))}
  </div>
</BaseLayout>
