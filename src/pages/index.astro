---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { getProjects, getPublishedPosts, withBase } from '../lib/content';

const projects = await getProjects();
const latestPosts = (await getPublishedPosts()).slice(0, 3);
---

<BaseLayout
  title="HOME"
  description="team-continue はロボコンに挑戦し続けるロボット開発チームです。CoREへの参戦記録、メカ・回路・ソフトウェアの技術情報を発信しています。"
>
  <section class="hero">
    <p class="hero-eyebrow">ROBOTICS TEAM</p>
    <h1 class="hero-title">
      続けることが、<br /><span class="hero-accent">ちからになる。</span>
    </h1>
    <p class="hero-desc">
      team-continue は、ロボコンに挑戦し続けるロボット開発チームです。<br
        class="pc-only"
      />メカ・回路・ソフトウェアの垣根を越えて、自律移動ロボットを作っています。
    </p>
    <div class="hero-cta">
      <a class="btn btn-primary" href={withBase('/projects')}>PROJECTを見る</a>
      <a class="btn btn-outline" href={withBase('/blog')}>BLOGを見る</a>
      <a class="btn btn-outline" href="https://github.com/team-continue" target="_blank" rel="noopener noreferrer">GitHubを見る</a>
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">PROJECT</h2>
    <div class="card-grid">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
    <p class="section-more"><a href={withBase('/projects')}>すべてのプロジェクトを見る →</a></p>
  </section>

  <section class="section">
    <h2 class="section-title">最新のBLOG</h2>
    <div class="card-grid">
      {latestPosts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
    <p class="section-more"><a href={withBase('/blog')}>記事一覧を見る →</a></p>
  </section>

  <section class="section home-links">
    <a class="card home-link-card" href={withBase('/members')}>
      <div class="card-body">
        <h2 class="card-title">MEMBERS</h2>
        <p class="card-summary">チームメンバーの紹介はこちら</p>
      </div>
    </a>
    <a class="card home-link-card" href={withBase('/links')}>
      <div class="card-body">
        <h2 class="card-title">SNS・LINK</h2>
        <p class="card-summary">SNSアカウント・関連リンクはこちら</p>
      </div>
    </a>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 4.5rem 0 3.5rem;
    position: relative;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: -2.5rem -100vw 0;
    background:
      radial-gradient(ellipse 60% 50% at 70% 20%, rgba(56, 225, 255, 0.1), transparent),
      radial-gradient(ellipse 50% 40% at 20% 80%, rgba(124, 92, 255, 0.1), transparent);
    pointer-events: none;
    z-index: -1;
  }

  .hero-eyebrow {
    font-family: var(--font-mono);
    color: var(--color-accent);
    letter-spacing: 0.35em;
    font-size: 0.8rem;
    margin: 0 0 1rem;
  }

  .hero-title {
    font-size: clamp(2.2rem, 6vw, 3.6rem);
    line-height: 1.25;
    margin: 0 0 1.25rem;
  }

  .hero-accent {
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-desc {
    color: var(--color-text-muted);
    font-size: 1.02rem;
    margin: 0 0 2rem;
  }

  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .pc-only {
    display: none;
  }

  @media (min-width: 640px) {
    .pc-only {
      display: inline;
    }
  }

  .home-links {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .home-links {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .home-link-card:hover {
    opacity: 1;
  }
</style>
